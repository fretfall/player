{
  "name": "@fretfall/player",
  "version": "0.4.1",
  "description": "An arcade-style 3D note highway for Guitar Pro and MusicXML tabs, in the browser. Plays along with the synth or the band's recording.",
  "keywords": ["guitar", "bass", "tab", "guitar-pro", "musicxml", "note-highway", "alphatab", "practice"],
  "license": "MIT",
  "author": "Angelo Dini",
  "homepage": "https://github.com/fretfall/player#readme",
  "repository": { "type": "git", "url": "git+https://github.com/fretfall/player.git" },
  "bugs": "https://github.com/fretfall/player/issues",
  "type": "module",
  "main": "./mount.js",
  "types": "./mount.d.ts",
  "exports": {
    ".": { "types": "./mount.d.ts", "default": "./mount.js" },
    "./mount.js": { "types": "./mount.d.ts", "default": "./mount.js" },
    "./*": "./*"
  },
  "private": true,
  "scripts": {
    "start": "esbuild 'src/*.js' --format=esm --outdir=demo/src --servedir=demo --serve=4410",
    "build": "node scripts/build.mjs",
    "lint": "oxlint --deny-warnings",
    "test": "node --test",
    "bench": "node scripts/bench.mjs dist"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "oxlint": "1.83.0"
  }
}
